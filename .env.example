# Public URL used by Better Auth when issuing cookies and redirects.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Generate a unique random secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# The only email permitted to create and use this personal deployment.
APP_OWNER_EMAIL=owner@example.com

# PostgreSQL is the canonical store for identity and application data.
DATABASE_URL=postgresql://ai_companion:ai_companion@127.0.0.1:5432/ai_companion

# Grok Build stores its OAuth session under this directory.
GROK_HOME=.data/grok

# Empty, isolated working directory used by the Grok CLI process.
COMPANION_RUNTIME_DIR=.data/runtime

# Optional API-key provider fallback for a later cloud deployment mode.
XAI_API_KEY=

NEXT_TELEMETRY_DISABLED=1
