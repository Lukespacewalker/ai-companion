# Grok Build stores its OAuth session under this directory.
# Keep it on persistent storage and never commit it.
GROK_HOME=.data/grok

# Empty, isolated working directory used by the Grok CLI process.
COMPANION_RUNTIME_DIR=.data/runtime

# Optional. Used only when the provider supports API-key authentication.
# The OAuth-first MVP does not require this.
XAI_API_KEY=

NEXT_TELEMETRY_DISABLED=1
